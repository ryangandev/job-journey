# Example environment variables. Copy this file to `.env` (or `.env.local`) and fill in real values.
# Placeholders only: never commit real secrets.

# --- Database (Vercel Postgres / Neon) ---
# Pooled connection, used by the app at runtime (src/lib/db.ts, Neon driver adapter)
POSTGRES_PRISMA_URL="postgresql://[username]:[password]@[pooled-host]/[databasename]?sslmode=require"
# Direct (non-pooled) connection, used by the Prisma CLI / migrations (prisma.config.ts)
POSTGRES_URL_NON_POOLING="postgresql://[username]:[password]@[host]/[databasename]?sslmode=require"

# --- Auth.js (next-auth v5) ---
# Generate one with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="your-auth-secret"

# GitHub OAuth app
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Google OAuth client
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- Email (Resend) ---
RESEND_API_KEY="re_your-resend-api-key"

# --- App ---
# Public site URL, used to build links in emails (no trailing slash)
APP_URL="http://localhost:3000"
